{% extends "base.html" %}
{% set active = "skills" %}
{% set main_class = "full" %}
{% block title %}Skill 庫{% endblock %}
{% block content %}
<style>
.skp { height: calc(100vh - 64px); overflow-y: auto; }
.skp-in { max-width: 1320px; margin: 0 auto; padding: 36px 40px 64px; }
/* Hero */
.skp-hero { text-align: center; margin-bottom: 44px; }
.skp-hero h1 { font-family: "Noto Serif TC", "Songti TC", Georgia, serif; font-weight: 400; font-size: 30px; letter-spacing: .04em; margin: 0 0 22px; }
.skp-box { max-width: 880px; margin: 0 auto; text-align: left; background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px 10px; transition: border-color .15s, box-shadow .15s; }
.skp-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--tint-accent); }
.skp-box textarea { width: 100%; min-height: 74px; resize: none; border: 0; outline: 0; background: transparent; color: var(--fg); font: inherit; font-size: 14.5px; line-height: 1.6; }
.skp-box-foot { display: flex; align-items: center; gap: 8px; }
.skp-pick { display: inline-flex; align-items: center; gap: 6px; padding: 4px 6px 4px 4px; border-radius: 999px; background: var(--tint-accent); border: 1px solid var(--tint-accent-line); font-size: 12.5px; color: var(--fg-soft); }
.skp-pick img { width: 22px; height: 22px; border-radius: 50%; object-fit: cover; background: var(--thumb); }
.skp-pick button { border: 0; background: none; color: var(--muted); cursor: pointer; font-size: 14px; line-height: 1; padding: 0 2px; }
.skp-hint { color: var(--muted); font-size: 12px; }
.skp-send { margin-left: auto; width: 34px; height: 34px; border-radius: 50%; border: 0; background: var(--accent); color: var(--on-accent); cursor: pointer; font-size: 16px; font-weight: 700; display: grid; place-items: center; }
.skp-send:disabled { background: var(--panel-2); color: var(--faint); cursor: default; }
/* Tabs + 分類 + 搜尋 */
.skp-tabs { display: flex; align-items: center; gap: 22px; margin-bottom: 14px; }
.skp-tabs .skp-search { margin-left: auto; }
.skp-tabs button { border: 0; background: none; padding: 0; font-size: 18px; font-weight: 600; color: var(--faint); cursor: pointer; }
.skp-tabs button.on { color: var(--fg); }
.skp-tabs em { font-style: normal; font-size: 12px; font-weight: 500; color: var(--muted); margin-left: 4px; }
.skp-bar { display: flex; align-items: center; gap: 16px; margin-bottom: 18px; }
.skp-cats { display: flex; flex-wrap: wrap; gap: 8px; flex: 1; min-width: 0; }
.skp-cats::-webkit-scrollbar { display: none; }
.skp-cats button { flex-shrink: 0; white-space: nowrap; padding: 7px 14px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--muted); cursor: pointer; font-size: 13px; transition: .12s; }
.skp-cats button:hover { color: var(--fg); border-color: var(--line-hover); }
.skp-cats button.on { background: var(--panel-2); color: var(--fg); border-color: var(--line-hover); font-weight: 600; }
.skp-search { position: relative; width: 300px; flex-shrink: 0; }
.skp-search input { width: 100%; padding: 8px 34px 8px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel); color: var(--fg); font-size: 13px; outline: 0; }
.skp-search input:focus { border-color: var(--accent); }
.skp-search svg { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
.skp-cnt { color: var(--muted); font-size: 12px; margin: -6px 0 12px; }
/* 卡片牆 */
.skp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 16px; }
.skc { position: relative; display: flex; gap: 14px; padding: 12px; border-radius: 14px; background: var(--panel); border: 1px solid var(--line); cursor: pointer; transition: border-color .15s, transform .15s, background .15s; min-width: 0; }
.skc:hover { border-color: var(--line-hover); background: var(--panel-2); transform: translateY(-2px); }
.skc-th { position: relative; width: 168px; height: 112px; flex-shrink: 0; border-radius: 10px; overflow: hidden; background: var(--thumb); }
.skc-th img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s; }
.skc:hover .skc-th img { transform: scale(1.05); }
.skc-tag { position: absolute; top: 7px; right: 7px; padding: 2px 7px; border-radius: 6px; font-size: 11px; color: #fff; background: rgba(0,0,0,.55); backdrop-filter: blur(4px); }
.skc-bd { min-width: 0; display: flex; flex-direction: column; flex: 1; }
.skc-bd b { font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 22px; }
.skc-bd p { margin: 6px 0 0; color: var(--muted); font-size: 12.5px; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.skc-meta { margin-top: auto; display: flex; gap: 10px; color: var(--faint); font-size: 11.5px; }
.skc-fav { position: absolute; top: 10px; right: 10px; border: 0; background: none; cursor: pointer; font-size: 15px; color: var(--faint); padding: 2px; }
.skc-fav.on { color: var(--warn); }
.skp-empty { grid-column: 1/-1; text-align: center; color: var(--muted); padding: 60px 0; }
/* 詳情抽屜 */
.skd-mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 50; opacity: 0; pointer-events: none; transition: opacity .2s; }
.skd-mask.open { opacity: 1; pointer-events: auto; }
.skd { position: fixed; top: 0; right: 0; bottom: 0; width: min(760px, 92vw); background: var(--bg); border-left: 1px solid var(--line); z-index: 51; transform: translateX(100%); transition: transform .25s ease; display: flex; flex-direction: column; }
.skd.open { transform: none; }
.skd-head { display: flex; align-items: center; gap: 10px; padding: 14px 20px; border-bottom: 1px solid var(--line); }
.skd-head b { flex: 1; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.skd-use { padding: 7px 16px; border-radius: 8px; border: 0; background: var(--accent); color: var(--on-accent); font-weight: 600; cursor: pointer; font-size: 13px; }
.skd-x { border: 0; background: none; color: var(--muted); font-size: 22px; cursor: pointer; line-height: 1; }
.skd-body { overflow-y: auto; padding: 20px 28px 48px; }
.skd-body h1 { font-size: 20px; border-bottom: 1px solid var(--line); padding-bottom: 8px; }
.skd-body h2 { font-size: 17px; margin-top: 28px; color: var(--accent); }
.skd-body h3 { font-size: 15px; }
.skd-body pre { background: var(--panel-2); padding: 12px; border-radius: var(--radius); overflow-x: auto; font-size: 12px; }
.skd-desc { color: var(--muted); margin: 8px 0 16px; }
.skd-extra h2 { color: var(--warn); }
.skd-fmt { margin: 12px 0; padding: 8px 12px; background: var(--panel-2); border-radius: var(--radius); font-family: ui-monospace, Menlo, monospace; font-size: 12px; color: var(--muted); white-space: pre-wrap; display: none; }
.skd-fmt.open { display: block; }
@media (max-width: 900px) { .skp-in { padding: 24px 16px 48px; } .skp-tabs { flex-wrap: wrap; } .skp-tabs .skp-search { width: 100%; margin-left: 0; } .skp-grid { grid-template-columns: 1fr; } .skc-th { width: 128px; height: 88px; } }
</style>
<div class="skp" id="skp">
  <div class="skp-in">
    <section class="skp-hero">
      <h1 id="t-hero">一個 Skill，一部作品</h1>
      <div class="skp-box">
        <textarea id="pin" placeholder="輸入你的創作靈感，或從下方挑選一個 Skill 開始"></textarea>
        <div class="skp-box-foot">
          <span id="pick"></span>
          <span class="skp-hint" id="t-hint">⌘ + Enter 送到 AI 導演</span>
          <button class="skp-send" id="send" title="送出" disabled>↑</button>
        </div>
      </div>
    </section>
    <div class="skp-tabs"><span id="tabs" style="display:contents"></span>
      <label class="skp-search">
        <input id="q" placeholder="搜尋 Skill">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </label>
    </div>
    <div class="skp-bar">
      <div class="skp-cats" id="cats"></div>
    </div>
    <div class="skp-cnt" id="cnt"></div>
    <div class="skp-grid" id="grid"></div>
  </div>
</div>
<div class="skd-mask" id="mask"></div>
<aside class="skd" id="drawer" aria-hidden="true">
  <div class="skd-head"><b id="d-title"></b><button class="skd-use" id="d-use">使用此 Skill</button><button class="skd-x" id="d-x" title="關閉">×</button></div>
  <div class="skd-body" id="d-body"></div>
</aside>
{% endblock %}
{% block scripts %}
<script>
(()=>{
const LMAP={'zh-Hant':'tc','zh-Hans':'sc','en':'en'};
const I18N={
  tc:{hero:'一個 Skill，一部作品',ph:'輸入你的創作靈感，或從下方挑選一個 Skill 開始',hint:'⌘ + Enter 送到 AI 導演',all:'全部',fav:'收藏',search:'搜尋 Skill',use:'使用此 Skill',empty:'沒有符合的 Skill',fm:'顯示／隱藏 frontmatter',extra:'附屬檔',loading:'載入中…',skill:'Skill'},
  sc:{hero:'一个 Skill，一部作品',ph:'输入你的创作灵感，或从下方挑选一个 Skill 开始',hint:'⌘ + Enter 发送到 AI 导演',all:'全部',fav:'收藏',search:'搜索 Skill',use:'使用此 Skill',empty:'没有符合的 Skill',fm:'显示／隐藏 frontmatter',extra:'附属文件',loading:'加载中…',skill:'Skill'},
  en:{hero:'One Skill, One Film',ph:'Describe your idea, or pick a Skill below to start',hint:'⌘ + Enter to send to AI Director',all:'All',fav:'Saved',search:'Search Skills',use:'Use this Skill',empty:'No matching Skills',fm:'Show / hide frontmatter',extra:'Attachment',loading:'Loading…',skill:'Skill'}
};
const CAT={'MV音樂':['MV音乐','Music Video'],'分鏡前期':['分镜前期','Storyboard'],'劇本喜劇':['剧本喜剧','Script & Comedy'],'動畫動漫':['动画动漫','Animation'],'廣告TVC':['广告TVC','Commercial'],'旅拍生活':['旅拍生活','Travel & Life'],'短劇漫劇':['短剧漫剧','Short Drama'],'自媒體口播':['自媒体口播','Creator Talk'],'視覺風格':['视觉风格','Visual Style'],'遊戲運動':['游戏运动','Game & Sport'],'電商帶貨':['电商带货','E-commerce'],'電影美學':['电影美学','Film Aesthetics']};
const $=id=>document.getElementById(id);
const store={get(k,d){try{return JSON.parse(localStorage.getItem(k))??d}catch{return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch{}}};
let DATA=[],CUR=-1,PICK=-1,CAT_SEL='',TAB='all',LANG=LMAP[window.REACH&&REACH.lang]||'tc',FAV=new Set(store.get('reach.skill.fav',[]));
const T=k=>I18N[LANG][k];
const esc=s=>String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const catName=c=>LANG==='tc'?c:(CAT[c]?CAT[c][LANG==='sc'?0:1]:c);
const title=s=>LANG==='en'?s.slug.replace(/-\d+$/,'').replace(/-/g,' ').replace(/\b\w/g,m=>m.toUpperCase()):(LANG==='sc'?(s.cn_sc||s.cn):s.cn);
const desc=s=>s.description[LANG]||s.description.tc;
const cover=s=>s.cover?'/api/skills/'+s.slug+'/cover':'';
function md(t){
  t=esc(t);
  t=t.replace(/```([\s\S]*?)```/g,(m,c)=>'<pre>'+c+'</pre>');
  t=t.replace(/^####\s?(.*)$/gm,'<h4>$1</h4>').replace(/^###\s?(.*)$/gm,'<h3>$1</h3>').replace(/^##\s?(.*)$/gm,'<h2>$1</h2>').replace(/^#\s?(.*)$/gm,'<h1>$1</h1>');
  t=t.replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>').replace(/^\s*[-*]\s(.*)$/gm,'• $1').replace(/\n/g,'<br>');
  return t;
}
function texts(){
  $('t-hero').textContent=T('hero');$('pin').placeholder=T('ph');$('t-hint').textContent=T('hint');
  $('q').placeholder=T('search');$('d-use').textContent=T('use');
}
function tabs(){
  const w=$('tabs');w.innerHTML='';
  [['all',T('skill'),DATA.length],['fav',T('fav'),FAV.size]].forEach(([v,l,n])=>{
    const b=document.createElement('button');b.className=TAB===v?'on':'';b.innerHTML=esc(l)+'<em>'+n+'</em>';
    b.onclick=()=>{TAB=v;tabs();render();};w.appendChild(b);
  });
}
function cats(){
  const w=$('cats');w.innerHTML='';
  ['',...new Set(DATA.map(s=>s.category))].forEach(c=>{
    const b=document.createElement('button');b.textContent=c?catName(c):T('all');
    if(CAT_SEL===c)b.className='on';
    b.onclick=()=>{CAT_SEL=c;cats();render();};w.appendChild(b);
  });
}
function render(){
  const q=$('q').value.trim().toLowerCase(),g=$('grid');g.innerHTML='';let n=0;
  DATA.forEach((s,i)=>{
    if(TAB==='fav'&&!FAV.has(s.slug))return;
    if(CAT_SEL&&s.category!==CAT_SEL)return;
    const hay=(s.cn+' '+(s.cn_sc||'')+' '+s.slug+' '+s.category+' '+s.description.tc+' '+s.description.sc+' '+s.description.en).toLowerCase();
    if(q&&!hay.includes(q))return;
    n++;
    const c=document.createElement('div');c.className='skc';
    c.innerHTML='<div class="skc-th">'+(s.cover?'<img loading="lazy" src="'+cover(s)+'" onerror="this.style.visibility=\'hidden\'">':'')+
      '<span class="skc-tag">'+esc(catName(s.category))+'</span></div>'+
      '<div class="skc-bd"><b>'+esc(title(s))+'</b><p>'+esc(desc(s))+'</p>'+
      '<div class="skc-meta"><span>v'+esc(s.version||'?')+'</span><span>'+(s.bytes/1024).toFixed(1)+' KB</span>'+(s.extras&&s.extras.length?'<span>+'+s.extras.length+' 附件</span>':'')+'</div></div>'+
      '<button class="skc-fav'+(FAV.has(s.slug)?' on':'')+'" title="'+esc(T('fav'))+'">★</button>';
    c.onclick=()=>open(i);
    c.querySelector('.skc-fav').onclick=e=>{e.stopPropagation();FAV.has(s.slug)?FAV.delete(s.slug):FAV.add(s.slug);store.set('reach.skill.fav',[...FAV]);tabs();render();};
    g.appendChild(c);
  });
  if(!n)g.innerHTML='<div class="skp-empty">'+esc(T('empty'))+'</div>';
  $('cnt').textContent=n+' / '+DATA.length;
}
async function open(i){
  CUR=i;const s=DATA[i],b=$('d-body');
  $('d-title').textContent=title(s);
  $('drawer').classList.add('open');$('mask').classList.add('open');$('drawer').setAttribute('aria-hidden','false');
  b.innerHTML='<div class="skd-desc">'+esc(T('loading'))+'</div>';b.scrollTop=0;
  const d=await (await fetch('/api/skills/'+s.slug+'?lang='+LANG)).json();
  let h='<h1>'+esc(title(s))+' <small style="color:var(--muted);font-size:12px">'+esc(catName(s.category))+' · '+esc(s.slug)+' · v'+esc(s.version||'?')+'</small></h1>';
  h+='<div class="skd-desc">'+esc(desc(s))+'</div>';
  if(s.cover)h+='<img src="'+cover(s)+'" style="width:100%;max-height:300px;object-fit:cover;border-radius:12px;margin-bottom:16px" onerror="this.style.display=\'none\'">';
  h+='<div class="skd-fmt" id="fm">'+esc(d.frontmatter)+'</div><div style="margin:8px 0"><a href="javascript:void(0)" onclick="document.getElementById(\'fm\').classList.toggle(\'open\')" style="color:var(--muted);font-size:12px">'+esc(T('fm'))+'</a></div>';
  h+=md(d.markdown);
  for(const e of (s.extras||[])){
    const ed=await (await fetch('/api/skills/'+s.slug+'/'+e+'?lang='+LANG)).json();
    h+='<div class="skd-extra"><h2>'+esc(T('extra'))+'：'+esc(e)+'</h2>'+md(ed.markdown||'')+'</div>';
  }
  if(CUR===i)b.innerHTML=h;
}
function close(){$('drawer').classList.remove('open');$('mask').classList.remove('open');$('drawer').setAttribute('aria-hidden','true');CUR=-1;}
function pick(i){
  PICK=i;const w=$('pick');
  if(i<0){w.innerHTML='';}else{const s=DATA[i];
    w.innerHTML='<span class="skp-pick">'+(s.cover?'<img src="'+cover(s)+'">':'')+esc(title(s))+'<button title="移除">×</button></span>';
    w.querySelector('button').onclick=()=>pick(-1);}
  sendState();
}
function sendState(){$('send').disabled=!($('pin').value.trim()||PICK>=0);}
function send(){
  if($('send').disabled)return;
  const s=PICK>=0?DATA[PICK]:null,txt=$('pin').value.trim();
  const pre=(s?'【使用 Skill：'+s.cn+'（'+s.slug+'）】\n':'')+txt;
  try{sessionStorage.setItem('reach.director.prefill',pre)}catch{}
  location.href='/director';
}
$('d-use').onclick=()=>{if(CUR<0)return;pick(CUR);close();$('skp').scrollTo({top:0,behavior:'smooth'});$('pin').focus();};
$('d-x').onclick=close;$('mask').onclick=close;
document.addEventListener('keydown',e=>{if(e.key==='Escape')close();});
$('q').oninput=render;
$('pin').oninput=sendState;
$('pin').onkeydown=e=>{if(e.key==='Enter'&&(e.metaKey||e.ctrlKey)){e.preventDefault();send();}};
$('send').onclick=send;
window.REACH&&REACH.onLang(l=>{LANG=LMAP[l]||'tc';texts();tabs();cats();render();if(PICK>=0)pick(PICK);if(CUR>=0)open(CUR);});
texts();
fetch('/api/skills').then(r=>r.json()).then(d=>{DATA=d.skills||[];FAV=new Set([...FAV].filter(x=>DATA.some(s=>s.slug===x)));tabs();cats();render();});
})();
</script>
{% endblock %}
